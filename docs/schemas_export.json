{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Academia AI Voice Co-Pilot Day 1 Schemas",
  "schemas": {
    "SourceReference": {
      "type": "object",
      "required": ["source_id", "source_type"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1, "maxLength": 64, "description": "Unique identifier (UUIDv4). Units: dimensionless ID." },
        "source_type": { "type": "string", "enum": ["screen", "active_window", "document", "audio_voice", "terminal", "application_state", "browser", "retrieved_knowledge", "conversation_history"] },
        "application_name": { "type": "string", "maxLength": 255, "description": "Originating application name (e.g. 'VS Code')." },
        "window_title": { "type": "string", "maxLength": 500, "description": "Window title string." },
        "document_uri": { "type": "string", "maxLength": 2048, "description": "File URI or path." },
        "page_number": { "type": "integer", "minimum": 1, "description": "1-based page index (PDF/presentation)." },
        "line_number": { "type": "integer", "minimum": 1, "description": "1-based line number (code/text)." },
        "bounding_box": { "$ref": "#/definitions/BoundingBox" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "ScreenContext": {
      "type": "object",
      "required": ["capture_id", "width", "height"],
      "properties": {
        "capture_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "timestamp": { "type": "string", "format": "date-time" },
        "capture_mode": { "type": "string", "enum": ["fullscreen", "active_window", "region", "selection"], "default": "active_window" },
        "application_name": { "type": "string", "maxLength": 255 },
        "window_title": { "type": "string", "maxLength": 500 },
        "width": { "type": "integer", "minimum": 1, "maximum": 16384, "description": "Width in pixels (px)." },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384, "description": "Height in pixels (px)." },
        "dpi_scale": { "type": "number", "minimum": 0.5, "maximum": 5.0, "default": 1.0 },
        "bounding_box": { "$ref": "#/definitions/BoundingBox" },
        "image_format": { "type": "string", "pattern": "^(image/png|image/jpeg|image/webp)$", "default": "image/webp" },
        "image_base64": { "type": "string", "maxLength": 10000000 },
        "ocr_text": { "type": "string", "maxLength": 100000 },
        "ocr_confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "contains_sensitive_data": { "type": "boolean", "default": false }
      }
    },
    "ContextItem": {
      "type": "object",
      "required": ["item_id", "context_type", "title", "content"],
      "properties": {
        "item_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "context_type": { "type": "string", "enum": ["user_query", "screen_ocr", "visual_summary", "application_metadata", "document_excerpt", "terminal_output", "code_snippet", "dialogue_history", "retrieved_doc"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "content": { "type": "string", "minLength": 1, "maxLength": 250000 },
        "metadata": { "type": "object" },
        "source": { "$ref": "#/schemas/SourceReference" },
        "relevance_score": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 1.0 },
        "token_count": { "type": "integer", "minimum": 0 },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "ReasoningRequest": {
      "type": "object",
      "required": ["request_id", "session_id", "user_query"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "user_query": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "modality": { "type": "string", "enum": ["voice", "text", "multimodal"], "default": "voice" },
        "screen_context": { "$ref": "#/schemas/ScreenContext" },
        "context_items": { "type": "array", "items": { "$ref": "#/schemas/ContextItem" }, "maxItems": 50 },
        "conversation_history": { "type": "array", "items": { "type": "object" }, "maxItems": 30 },
        "available_tools": { "type": "array", "items": { "type": "string" } },
        "allow_agentic_planning": { "type": "boolean", "default": true },
        "max_tokens": { "type": "integer", "minimum": 64, "maximum": 8192, "default": 1024 },
        "temperature": { "type": "number", "minimum": 0.0, "maximum": 2.0, "default": 0.2 },
        "stream_response": { "type": "boolean", "default": false },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "ReasoningResult": {
      "type": "object",
      "required": ["response_id", "request_id", "session_id", "user_intent", "response_text", "confidence_score", "processing_time_ms"],
      "properties": {
        "response_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "user_intent": { "type": "string", "minLength": 1, "maxLength": 100 },
        "response_text": { "type": "string" },
        "reasoning_summary": { "type": "string" },
        "tool_call_required": { "type": "boolean", "default": false },
        "action_plan": { "type": "array", "items": { "$ref": "#/definitions/ActionStep" } },
        "risk_level": { "type": "string", "enum": ["category_a_informational", "category_b_low_risk", "category_c_sensitive", "category_d_high_risk_destructive"], "default": "category_a_informational" },
        "requires_user_approval": { "type": "boolean", "default": false },
        "approval_prompt": { "type": "string", "maxLength": 500 },
        "sources_used": { "type": "array", "items": { "$ref": "#/schemas/SourceReference" } },
        "confidence_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "processing_time_ms": { "type": "number", "minimum": 0.0 },
        "status": { "type": "string", "enum": ["success", "requires_clarification", "needs_approval", "execution_in_progress", "failed"], "default": "success" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "definitions": {
    "BoundingBox": {
      "type": "object",
      "required": ["x_min", "y_min", "x_max", "y_max"],
      "properties": {
        "x_min": { "type": "number", "minimum": 0.0 },
        "y_min": { "type": "number", "minimum": 0.0 },
        "x_max": { "type": "number", "minimum": 0.0 },
        "y_max": { "type": "number", "minimum": 0.0 },
        "is_normalized": { "type": "boolean", "default": false }
      }
    },
    "ActionStep": {
      "type": "object",
      "required": ["step_number", "tool_name", "step_description"],
      "properties": {
        "step_number": { "type": "integer", "minimum": 1 },
        "tool_name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "tool_parameters": { "type": "object" },
        "step_description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "risk_level": { "type": "string", "enum": ["category_a_informational", "category_b_low_risk", "category_c_sensitive", "category_d_high_risk_destructive"], "default": "category_a_informational" },
        "requires_approval": { "type": "boolean", "default": false }
      }
    }
  }
}
